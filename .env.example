# Convia Environment Configuration Template (.env.example)

# Express Backend Server Configuration
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000

# Google Gemini AI Provider Configuration (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Firebase Admin SDK Credentials (Server-Side)
FIREBASE_PROJECT_ID=brainsync-07
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@brainsync-07.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Firebase Client Configuration (Frontend & Realtime Database)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_public_key

# UploadThing File Storage Provider Configuration
UPLOADTHING_TOKEN=your_uploadthing_token_id
VITE_UPLOADTHING_APP_ID=your_uploadthing_app_id

# Platform Admin Portal Authentication
VITE_ADMIN_EMAIL=admin@convia.dev
ADMIN_EMAIL=admin@convia.dev