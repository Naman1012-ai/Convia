rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organization_members/$(workspaceId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/organizations/$(workspaceId)).data.ownerId == request.auth.uid
      );
    }

    // User profiles
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isUser(uid);
      
      // User-specific persistent notifications
      match /notifications/{notificationId} {
        allow read: if isUser(uid);
        allow create: if isAuthenticated() && (
          isUser(uid) || 
          request.resource.data.actorId == request.auth.uid ||
          request.resource.data.actorId == 'system'
        );
        allow update: if isUser(uid);
        allow delete: if isUser(uid);
      }
    }

    // Workspaces and Organizations
    match /organizations/{workspaceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        !exists(/databases/$(database)/documents/organizations/$(workspaceId)) ||
        resource.data.ownerId == request.auth.uid
      );
    }

    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      // Workspace Activity Audit Trail
      match /activities/{activityId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.actorId == request.auth.uid ||
          request.resource.data.actorId == 'system'
        );
        allow update, delete: false; // Immutable audit log
      }
    }

    // Root collections for ideas, discussions, and blueprints
    match /ideas/{ideaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /blueprints/{blueprintId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /discussions/{discussionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
